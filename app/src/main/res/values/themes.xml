<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform base theme; Compose handles in-app styling (see ui/). The window background is
         the page colour, so nothing flashes white before the first frame. -->
    <style name="Theme.TandemMoto" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
    </style>

    <!-- Launch theme: the system splash (app icon), dismissed automatically once the first
         frame is ready, then Theme.TandemMoto. -->
    <style name="Theme.TandemMoto.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TandemMoto</item>
    </style>
</resources>
