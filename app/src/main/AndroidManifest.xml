<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi Direct phone-to-phone link (PRD §5.1) -->
    <!-- Location is only needed for Wi-Fi Direct discovery on API 32 and below -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The command channel is a TCP socket over the Wi-Fi Direct group: Android refuses any
         socket without INTERNET (EPERM, spike #22). The app never talks to the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Low-latency Wi-Fi lock while the channel is open (link/LowLatencyWifiLock.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permissions are added in the PR that builds the feature using them, never ahead of it:
         RECORD_AUDIO with the intercom (Phase 4); POST_NOTIFICATIONS and the foreground service
         ones (FOREGROUND_SERVICE, _MICROPHONE, _CONNECTED_DEVICE) with the service, which also
         needs a Play declaration and demo video per type (see service/README.md);
         READ_PHONE_STATE with call hold (Phase 5).
         No Bluetooth permission: the handlebar remote arrives as media-button events via
         MediaSession, and earbud audio/mic routing goes through AudioManager. -->

    <application
        android:name=".TandemMotoApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.TandemMoto">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TandemMoto.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the diagnostic log export only when the user asks (Settings → Export). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_export_paths" />
        </provider>
    </application>
</manifest>
